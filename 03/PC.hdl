CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:

    Inc16(in=out, out=incOut);

    Mux16(a=out, b=incOut, sel=inc, out=incMux);

    Mux16(a=incMux, b=in, sel=load, out=loadMux);

    Mux16(a=loadMux, b=false, sel=reset, out=resetMux);

    Register(in=resetMux, load=true, out=out);
}